@app.post(
    "/trade/buy",
    summary="Abrir posición de compra",
    description="Abre una posición de compra (BUY) para el símbolo indicado.",
    tags=["Trading"],
)
def trade_buy(
    symbol: str = Query(..., description="Símbolo del activo (ej: AAPL)"),
    amount_usd: float = Query(default=100.0, description="Cantidad en USD"),
    stop_loss: Optional[float] = Query(default=None, description="Stop loss opcional"),
):
    """
    Abre una posición de compra para el símbolo especificado.
    Cantidad en USD determina el tamaño de la posición.
    """
    try:
        result = _trading.buy_with_money_stop(symbol.upper(), amount_usd, stop_loss or 0)
        return {
            "status": "success",
            "action": "BUY",
            "symbol": symbol.upper(),
            "amount_usd": amount_usd,
            "result": result,
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


