@app.post(
    "/trade/close",
    summary="Cerrar posición",
    description="Cierra la posición abierta para el símbolo indicado.",
    tags=["Trading"],
)
def trade_close(
    symbol: str = Query(..., description="Símbolo del activo (ej: AAPL)"),
):
    """
    Cierra cualquier posición abierta para el símbolo especificado.
    """
    try:
        result = _trading.execute_target_position(symbol.upper(), 'sell', 0)
        return {
            "status": "success",
            "action": "CLOSE",
            "symbol": symbol.upper(),
            "result": result,
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get(
    "/trade/position/{symbol}",
    summary="Estado de posición",
    description="Devuelve el estado de la posición actual para el símbolo.",
    tags=["Trading"],
)
def get_position(symbol: str):
    """Retorna información de la posición actual para el símbolo."""
    try:
        position = _trading.get_position(symbol.upper())
        if position:
            return {
                "symbol": symbol.upper(),
                "qty": float(position.qty),
                "avg_entry_price": float(position.avg_entry_price),
                "current_price": float(position.current_price),
                "unrealized_pl": float(position.unrealized_pl),
                "side": position.side,
            }
        return {"symbol": symbol.upper(), "position": None, "message": "No hay posición abierta"}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@app.get(
    "/trade/account",
    summary="Estado de la cuenta",
    description="Devuelve el estado actual de la cuenta de trading.",
    tags=["Trading"],
)
def get_account():
    """Retorna información de la cuenta de trading."""
    try:
        return _trading.accountInfo()
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


