{
  "name": "BOLLINGER_ONLY_UP_03",
  "base_strategy": "bollinger",
  "params": {
    "only_up": true,
    "blg_dist_percent": 70,
    "medstd_min_diff": 0.5,
    "enable_control_open": true
  },
  "conditions": {
    "open": [
      {"indicator": "blg_upper_dst_percent", "op": ">", "value": 10},
      {"indicator": "week_flow", "op": "==", "value": "WEEK_FLOW_UP"}
    ],
    "close": [
      {"indicator": "blg_middle_dst_percent", "op": "<", "value": 5}
    ]
  }
}
